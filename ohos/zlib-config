#!/bin/sh -e

: "${OHOS_NDK_HOME:?set OHOS_NDK_HOME to the OpenHarmony SDK directory}"
: "${OHOS_DEPS_PREFIX:?set OHOS_DEPS_PREFIX to the dependency install prefix}"
: "${OHOS_HOST:?set OHOS_HOST to the OpenHarmony target triple}"

if [ -d "$OHOS_NDK_HOME/native" ]; then
  NATIVE=$OHOS_NDK_HOME/native
else
  NATIVE=$OHOS_NDK_HOME
fi
TOOLCHAIN=$NATIVE/llvm/bin

CHOST=$OHOS_HOST \
CC=$TOOLCHAIN/$OHOS_HOST-clang \
AR=$TOOLCHAIN/llvm-ar \
RANLIB=$TOOLCHAIN/llvm-ranlib \
./configure \
  --prefix="$OHOS_DEPS_PREFIX" \
  --libdir="$OHOS_DEPS_PREFIX/lib" \
  --includedir="$OHOS_DEPS_PREFIX/include" \
  --static
