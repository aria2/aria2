# Build with local BuildKit contexts:
#
#   docker buildx build --platform linux/amd64 \
#     --build-context ohos-sdk=/path/to/linux/openharmony \
#     --build-context ohos-openssl=/path/to/ohos-openssl \
#     --output type=local,dest=ohos-docker-out \
#     -f Dockerfile.ohos .
#
# The ohos-openssl context must include its .git directory and origin/111.

FROM ubuntu:22.04 AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG OPENSSL_REF=origin/111

ENV OHOS_ABI=arm64-v8a \
    OHOS_HOST=aarch64-unknown-linux-ohos \
    OHOS_NDK_HOME=/opt/ohos-sdk \
    OHOS_DEPS_PREFIX=/opt/ohos-deps/arm64-v8a \
    EXPAT_VERSION=2.5.0 \
    ZLIB_VERSION=1.3.1 \
    CARES_VERSION=1.21.0 \
    LIBSSH2_VERSION=1.11.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      autoconf automake autopoint bzip2 ca-certificates curl dpkg-dev \
      gettext git libtool make pkg-config xz-utils zip && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ohos-sdk / /opt/ohos-sdk/
COPY --from=ohos-openssl / /opt/ohos-openssl/
COPY config.sub config.guess /opt/build-aux/
COPY ohos/generic-config ohos/zlib-config /opt/ohos-config/

# Stage only OpenSSL 1.1 from the local repository's 111 branch.
RUN mkdir -p "$OHOS_DEPS_PREFIX" && \
    git -C /opt/ohos-openssl rev-parse --verify "$OPENSSL_REF" && \
    git -C /opt/ohos-openssl archive --format=tar \
      --output=/tmp/openssl-111.tar "$OPENSSL_REF" "prelude/$OHOS_ABI" && \
    tar -xf /tmp/openssl-111.tar -C "$OHOS_DEPS_PREFIX" \
      --strip-components=2 && \
    grep -q 'OpenSSL 1\.1' \
      "$OHOS_DEPS_PREFIX/include/openssl/opensslv.h" && \
    rm -f /tmp/openssl-111.tar \
      "$OHOS_DEPS_PREFIX/lib/libssl.so" \
      "$OHOS_DEPS_PREFIX/lib/libcrypto.so" && \
    for pc in "$OHOS_DEPS_PREFIX"/lib/pkgconfig/*.pc; do \
      sed -i "s|^prefix=.*|prefix=$OHOS_DEPS_PREFIX|" "$pc"; \
    done

WORKDIR /root/build

RUN curl -fL -o expat.tar.bz2 \
      "https://github.com/libexpat/libexpat/releases/download/R_2_5_0/expat-$EXPAT_VERSION.tar.bz2" && \
    tar -xjf expat.tar.bz2 && rm expat.tar.bz2
WORKDIR /root/build/expat-${EXPAT_VERSION}
RUN find . -name config.sub -exec cp /opt/build-aux/config.sub {} \; && \
    find . -name config.guess -exec cp /opt/build-aux/config.guess {} \; && \
    OHOS_BUILD="$(dpkg-architecture -qDEB_BUILD_GNU_TYPE)" \
      /opt/ohos-config/generic-config \
        --without-docbook --without-xmlwf --without-examples --without-tests && \
    make -j"$(nproc)" install

WORKDIR /root/build
RUN curl -fL -o zlib.tar.gz \
      "https://github.com/madler/zlib/releases/download/v$ZLIB_VERSION/zlib-$ZLIB_VERSION.tar.gz" && \
    tar -xzf zlib.tar.gz && rm zlib.tar.gz
WORKDIR /root/build/zlib-${ZLIB_VERSION}
RUN /opt/ohos-config/zlib-config && make -j"$(nproc)" install

WORKDIR /root/build
RUN curl -fL -o c-ares.tar.gz \
      "https://github.com/c-ares/c-ares/releases/download/cares-1_21_0/c-ares-$CARES_VERSION.tar.gz" && \
    tar -xzf c-ares.tar.gz && rm c-ares.tar.gz
WORKDIR /root/build/c-ares-${CARES_VERSION}
RUN find . -name config.sub -exec cp /opt/build-aux/config.sub {} \; && \
    find . -name config.guess -exec cp /opt/build-aux/config.guess {} \; && \
    OHOS_BUILD="$(dpkg-architecture -qDEB_BUILD_GNU_TYPE)" \
      /opt/ohos-config/generic-config --disable-tests && \
    make -j"$(nproc)" install

WORKDIR /root/build
RUN curl -fL -o libssh2.tar.bz2 \
      "https://libssh2.org/download/libssh2-$LIBSSH2_VERSION.tar.bz2" && \
    tar -xjf libssh2.tar.bz2 && rm libssh2.tar.bz2
WORKDIR /root/build/libssh2-${LIBSSH2_VERSION}
RUN find . -name config.sub -exec cp /opt/build-aux/config.sub {} \; && \
    find . -name config.guess -exec cp /opt/build-aux/config.guess {} \; && \
    OHOS_BUILD="$(dpkg-architecture -qDEB_BUILD_GNU_TYPE)" \
      /opt/ohos-config/generic-config \
        --with-crypto=openssl \
        --with-libssl-prefix="$OHOS_DEPS_PREFIX" \
        --disable-examples-build && \
    make -j"$(nproc)" install

# Copy the current source tree after the dependency layers so source changes do
# not invalidate the dependency build cache.
COPY . /root/build/aria2
WORKDIR /root/build/aria2
RUN autoreconf -fi && \
    cp /opt/build-aux/config.sub /opt/build-aux/config.guess . && \
    cp /opt/build-aux/config.sub /opt/build-aux/config.guess deps/wslay/ && \
    ./ohos-config aarch64 && \
    ./ohos-release aarch64

FROM scratch AS package
COPY --from=build \
  /root/build/aria2/aria2-*-aarch64-linux-ohos-build*.zip /
